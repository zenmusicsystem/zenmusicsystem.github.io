  <!-- Logo officiel ZMS intégré au fichier HTML : aucune ressource externe requise -->
  <script type="text/plain" id="zms-logo-data">data:image/png;base64,</script>
  <script>
    (() => {
      // Utilise le logo officiel fourni, intégré directement dans ce fichier HTML.
      const logoSource = document.getElementById('zms-logo-data')?.textContent.trim();
      if (logoSource) {
        document.querySelectorAll('img[data-zms-logo]').forEach((logo) => {
          logo.src = logoSource;
        });
      }

      const menuButton = document.getElementById('mobileMenuBtn');
      const drawer = document.getElementById('mobileDrawer');

      if (menuButton && drawer) {
        menuButton.addEventListener('click', () => {
          const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
          menuButton.setAttribute('aria-expanded', String(!isOpen));
          drawer.classList.toggle('hidden', isOpen);
          menuButton.setAttribute('aria-label', isOpen ? 'Ouvrir le menu' : 'Fermer le menu');
        });

        drawer.querySelectorAll('a[href^="#"]').forEach((link) => {
          link.addEventListener('click', () => {
            drawer.classList.add('hidden');
            menuButton.setAttribute('aria-expanded', 'false');
            menuButton.setAttribute('aria-label', 'Ouvrir le menu');
          });
        });
      }

      const year = document.getElementById('currentYear');
      if (year) year.textContent = new Date().getFullYear();

      const renderIcons = () => {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
          window.lucide.createIcons();
        }
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderIcons, { once: true });
      } else {
        renderIcons();
      }
    })();
  </script>
